        <PackageReference Include="Soenneker.Utils.Test" Version="4.0.330" />
        <PackageReference Include="Soenneker.Tests.HostedUnit" Version="4.0.285" />
        <PackageReference Include="TUnit" Version="1.69.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.SignalR.Web.Client\Soenneker.SignalR.Web.Client.csproj" />
    </ItemGroup>
</Project>

